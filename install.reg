[HKEY_CURRENT_USER\Software\Classes\FastImageViewer.gif\DefaultIcon]
@="C:\\Users\\Administrator\\AppData\\Local\\Programs\\FastImageViewer\\FastImageViewer.exe,0"
[HKEY_CURRENT_USER\Software\Classes\FastImageViewer.gif\shell\open\command]
@="\"C:\\Users\\Administrator\\AppData\\Local\\Programs\\FastImageViewer\\FastImageViewer.exe\" \"%1\""

[HKEY_CURRENT_USER\Software\Classes\.gif]
@="FastImageViewer.gif"
