Windows Registry Editor Version 5.00

; ============================================================
;  极速看图 FastImageViewer  —  安装 & 注册为默认图片打开方式
;  作用范围：仅当前用户（HKCU），不污染系统，可一键卸载
; ============================================================

; ---------- 1. 注册应用程序本体 ----------
[HKEY_CURRENT_USER\Software\Classes\Applications\FastImageViewer.exe]
"FriendlyAppName"="极速看图"
"ApplicationIcon"="C:\\Users\\Administrator\\AppData\\Local\\Programs\\FastImageViewer\\FastImageViewer.exe,0"

[HKEY_CURRENT_USER\Software\Classes\Applications\FastImageViewer.exe\shell\open\command]
@="\"C:\\Users\\Administrator\\AppData\\Local\\Programs\\FastImageViewer\\FastImageViewer.exe\" \"%1\""

[HKEY_CURRENT_USER\Software\Classes\Applications\FastImageViewer.exe\SupportedTypes]
".jpg"=""
".jpeg"=""
".png"=""
".gif"=""
".bmp"=""
".webp"=""
".tiff"=""
".tif"=""
".ico"=""

; ---------- 2. 注册 ProgID：JPEG ----------
[HKEY_CURRENT_USER\Software\Classes\FastImageViewer.jpg]
@="图片文件 (极速看图)"
[HKEY_CURRENT_USER\Software\Classes\FastImageViewer.jpg\DefaultIcon]
@="C:\\Users\\Administrator\\AppData\\Local\\Programs\\FastImageViewer\\FastImageViewer.exe,0"
[HKEY_CURRENT_USER\Software\Classes\FastImageViewer.jpg\shell\open\command]
@="\"C:\\Users\\Administrator\\AppData\\Local\\Programs\\FastImageViewer\\FastImageViewer.exe\" \"%1\""

[HKEY_CURRENT_USER\Software\Classes\.jpg]
@="FastImageViewer.jpg"
[HKEY_CURRENT_USER\Software\Classes\.jpg\OpenWithProgids]
"FastImageViewer.jpg"=""

[HKEY_CURRENT_USER\Software\Classes\.jpeg]
@="FastImageViewer.jpg"
[HKEY_CURRENT_USER\Software\Classes\.jpeg\OpenWithProgids]
"FastImageViewer.jpg"=""

; ---------- 3. 注册 ProgID：PNG ----------
[HKEY_CURRENT_USER\Software\Classes\FastImageViewer.png]
@="图片文件 (极速看图)"
[HKEY_CURRENT_USER\Software\Classes\FastImageViewer.png\DefaultIcon]
@="C:\\Users\\Administrator\\AppData\\Local\\Programs\\FastImageViewer\\FastImageViewer.exe,0"
[HKEY_CURRENT_USER\Software\Classes\FastImageViewer.png\shell\open\command]
@="\"C:\\Users\\Administrator\\AppData\\Local\\Programs\\FastImageViewer\\FastImageViewer.exe\" \"%1\""

[HKEY_CURRENT_USER\Software\Classes\.png]
@="FastImageViewer.png"
[HKEY_CURRENT_USER\Software\Classes\.png\OpenWithProgids]
"FastImageViewer.png"=""

