[HKEY_CURRENT_USER\Software\Classes\.ico]
@="FastImageViewer.ico"
[HKEY_CURRENT_USER\Software\Classes\.ico\OpenWithProgids]
"FastImageViewer.ico"=""

; ---------- 9. 允许从"运行"直接启动 ----------
[HKEY_CURRENT_USER\SOFTWARE\Microsoft\Windows\CurrentVersion\App Paths\FastImageViewer.exe]
@="C:\\Users\\Administrator\\AppData\\Local\\Programs\\FastImageViewer\\FastImageViewer.exe"
"Path"="C:\\Users\\Administrator\\AppData\\Local\\Programs\\FastImageViewer"

; ---------- 10. 清除 Windows 的"默认应用"锁定缓存 ----------
; Windows 会优先读取 UserChoice，必须清掉它，上面注册的默认值才会真正生效
[-HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\FileExts\.jpg\UserChoice]
[-HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\FileExts\.jpeg\UserChoice]
[-HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\FileExts\.png\UserChoice]
[-HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\FileExts\.gif\UserChoice]
[-HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\FileExts\.bmp\UserChoice]
[-HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\FileExts\.webp\UserChoice]
[-HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\FileExts\.tiff\UserChoice]
[-HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\FileExts\.tif\UserChoice]
[-HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\FileExts\.ico\UserChoice]

; 同时在 FileExts 的 OpenWithList 中登记，保证"打开方式"列表里能看到
[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\FileExts\.jpg\OpenWithProgids]
"FastImageViewer.jpg"=hex(0):
[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\FileExts\.png\OpenWithProgids]
"FastImageViewer.png"=hex(0):
[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\FileExts\.gif\OpenWithProgids]
"FastImageViewer.gif"=hex(0):
[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\FileExts\.bmp\OpenWithProgids]
"FastImageViewer.bmp"=hex(0):
[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\FileExts\.webp\OpenWithProgids]
"FastImageViewer.webp"=hex(0):